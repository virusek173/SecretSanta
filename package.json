{
  "name": "secret-santa",
  "version": "1.0.0",
  "description": "Secret Santa gift exchange application with AI-powered messages and images",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "santa": "npm run build && node dist/index.js",
    "santa:no-images": "npm run build && node dist/index.js --no-images",
    "santa:dry-run": "npm run build && node dist/index.js --dry-run",
    "santa:encrypt-logs": "npm run build && node dist/index.js --encrypt-logs",
    "santa:dry-run-no-images": "npm run build && node dist/index.js --dry-run --no-images",
    "santa:resume": "npm run build && node dist/index.js --resume",
    "santa:fresh": "npm run build && node dist/index.js --fresh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "ts-node src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "secret-santa",
    "gift-exchange",
    "ai",
    "openai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@sendgrid/client": "^8.1.6",
    "@sendgrid/mail": "^8.1.6",
    "dotenv": "^18.0.10",
    "openai": "^7.56.0",
    "validator": "^13.15.35"
  }
}
